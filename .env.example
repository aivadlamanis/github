# Required. Create a key in the Anthropic Console. Never commit the real value.
ANTHROPIC_API_KEY=

# Required in production. The shared passcode your team types to enter the app.
APP_PASSCODE=

# Optional. Signs the session cookie. Falls back to APP_PASSCODE.
SESSION_SECRET=

# Optional. Defaults to claude-sonnet-5-5.
NEXAFLOW_MODEL=
